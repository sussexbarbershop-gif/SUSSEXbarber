{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/daily?job=evening",
      "schedule": "0 18 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/ADMIN",
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/ADMIN/",
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/Admin",
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/Admin/",
      "destination": "/admin",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/manifest.webmanifest",
      "destination": "/api/manifest"
    }
  ]
}
