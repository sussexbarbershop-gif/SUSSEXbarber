{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/daily",
      "schedule": "0 7 * * *"
    }
  ],
  "redirects": [
    { "source": "/ADMIN", "destination": "/admin", "permanent": false },
    { "source": "/ADMIN/", "destination": "/admin", "permanent": false },
    { "source": "/Admin", "destination": "/admin", "permanent": false },
    { "source": "/Admin/", "destination": "/admin", "permanent": false }
  ]
}
